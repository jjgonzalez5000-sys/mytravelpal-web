# Copy this to `.env` (gitignored) and fill in the values.

# Grafana admin login. Change the password if the dashboard host
# leaves the local machine.
GRAFANA_ADMIN_PASSWORD=admin

# Token the `fly-proxy` service uses to open the tunnel to the database.
# Create one and paste it here (never commit it; .env is gitignored):
#   flyctl tokens create deploy -a mytravelpal-db
# If the proxy then reports it is not authorised for that app, use an org
# token instead:  flyctl tokens create org
FLY_API_TOKEN=REPLACE_ME
# Fly app that holds the database (default: mytravelpal-db).
# FLY_DB_APP=mytravelpal-db

# Fly Postgres connection details. Get them from the Fly app config:
#   flyctl postgres users list -a mytravelpal-db
#   flyctl secrets list -a mytravelpal-db      (to see which secrets exist)
#   flyctl ssh console -a mytravelpal-db       (for interactive lookup)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mytravelpal_api
PG_USER=postgres
PG_PASSWORD=REPLACE_ME
