# Copy this to `.env` (gitignored) and fill in the values.

# Grafana admin login. Change the password if the dashboard host
# leaves the local machine.
GRAFANA_ADMIN_PASSWORD=admin

# Fly Postgres connection details. Get them from the Fly app config:
#   flyctl postgres users list -a mytravelpal-db
#   flyctl secrets list -a mytravelpal-db      (to see which secrets exist)
#   flyctl ssh console -a mytravelpal-db       (for interactive lookup)
# The `flyctl proxy 5432 -a mytravelpal-db` command MUST be running
# on the host in a separate terminal so host.docker.internal:5432
# resolves to the tunnel.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=mytravelpal_api
PG_USER=postgres
PG_PASSWORD=REPLACE_ME
