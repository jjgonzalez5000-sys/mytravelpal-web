{
  "name": "mytravelpal-web",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // true: every request passes the Worker so the old hosts and the apex
    // get their 301 to https://www.optitrips.com (see worker.js).
    "run_worker_first": true
  }
}
