<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Location — powers the "Use my location" button on the search
         screen. Coarse is enough for city-level reverse geocoding;
         fine is declared so Android grants the more useful accuracy
         tier when the user picks "Precise" in the runtime dialog. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Background location — required for tracking to keep flowing
         when the driver Alt-Tabs to Google Maps for turn-by-turn.
         Android 10+ prompts a separate "Allow all the time" dialog
         AFTER the fine-location grant. The user can leave it at
         "only while app is open" and the dashboard will still work
         in the foreground; the wake-lock keeps the screen on. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Foreground service permissions for the "trip in progress"
         ongoing notification and, in Phase 4b, the actual
         background-location foreground service. Declared here now
         so integrating `flutter_background_service` later doesn't
         need a manifest-only rebuild. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- FOREGROUND_SERVICE_DATA_SYNC covers the "planificando tu viaje"
         ongoing notification we show while /plan is in flight (network
         data sync). Android 14+ rejects starting a foreground service
         without a matching typed permission — without this the plugin's
         `startForeground(..., FOREGROUND_SERVICE_TYPE_MANIFEST)` call
         throws MissingForegroundServiceTypeException and the tray
         notification never appears. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- WakeLock is required by wakelock_plus to keep the screen on
         while the trip dashboard is foregrounded. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- POST_NOTIFICATIONS is required on Android 13+ to show
         approaching-stop / new-alert push notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- READ_CONTACTS lets the user pick emergency contacts from the
         device address book on the Emergency Contacts screen instead
         of typing name + phone by hand. Prompted at runtime only
         when the user taps the "Pick from contacts" button; users
         can still add contacts manually if they deny. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:label="mytravelpal"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep-link intent filter for shared trips
                 (mytravelpal://trip?o=…&d=…&t=…) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mytravelpal" android:host="trip" />
            </intent-filter>
            <!-- ACTION_SEND filter — makes MyTravelPal show up in the
                 Android share sheet for plain-text shares. The driver
                 taps "Share" on a Google Maps route, picks MyTravelPal,
                 and MainActivity.kt hands the shared URL to Dart via
                 the `mytravelpal/share` MethodChannel; the deep-link
                 handler then parses it with `parseGoogleMapsUrl` and
                 opens PlanScreen prefilled. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Facebook Login. Values live in res/values/strings.xml
             so we don't leak the App ID / Client Token into VCS
             beyond the placeholder. Once real values are set the
             SDK auto-picks them up on startup. -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:label="@string/app_name"
            android:exported="false" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>

        <!-- Android Auto integration: MyTravelPal is registered in
             the POI (Point of Interest) category so it appears in
             the head unit alongside Google Maps / Waze without
             competing with them for turn-by-turn navigation. See
             `project_android_auto` memory for the full strategy.

             Category is set via the automotive_app_desc.xml
             resource file — Google Auto reads that at review time
             to route the app to the correct category reviewer. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Home-screen widget with countdown to the next saved
             trip. See `widget/NextTripWidgetProvider.kt`. -->
        <receiver
            android:name="com.mytravelpal.travel.widget.NextTripWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_trip_widget_info" />
        </receiver>

        <!-- flutter_foreground_task's own service. The plugin's manifest
             only declares FOREGROUND_SERVICE permission, but the actual
             <service> element MUST live in the app manifest — otherwise
             `startForeground(id, notif, FOREGROUND_SERVICE_TYPE_MANIFEST)`
             finds no serviceType on Android 14+ and the start fails
             silently (wrapped in a ServiceRequestFailure). Types combine
             the two use-cases we drive through this single service:
             `dataSync` for the /plan HTTP call held open while the app
             is backgrounded, and `location` for the companion drive
             GPS tracking. Do NOT rename the service class — the plugin
             hard-codes this fully-qualified name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name="com.mytravelpal.travel.car.MyTravelPalCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
            <!-- Minimum Car App API level. 3 is the entry point that
                 supports PaneTemplate / PlaceListTemplate. Bump when
                 we adopt newer templates. -->
            <meta-data
                android:name="androidx.car.app.minCarApiLevel"
                android:value="3" />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Facebook SDK checks if the FB app is installed so it
             can hand off login through it (faster than webview). -->
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.orca" />
    </queries>
</manifest>
