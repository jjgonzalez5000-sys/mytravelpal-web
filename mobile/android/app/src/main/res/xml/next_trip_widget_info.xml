<?xml version="1.0" encoding="utf-8"?>
<!--
    AppWidget metadata. Sizes are conservative — 2×1 minimum
    so pin-drag from the widget picker works on compact launchers.
    updatePeriodMillis is 30 min (Android's minimum since API 5) —
    the countdown still ticks tighter via explicit
    NextTripWidgetProvider.requestRefresh from Flutter.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/next_trip_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"/>
